# git-drive-backup settings. Copy this file to config.env and edit it.
# config.env is in .gitignore, so your own paths never reach GitHub.

# The folder your cloud drive syncs. Any synced folder works: Google Drive,
# iCloud Drive, Dropbox, OneDrive, or a plugged-in external disk.
# Find the exact path in Finder: right-click the folder, hold Option, "Copy as Pathname".
CLOUD_DIR="$HOME/Library/CloudStorage/GoogleDrive-you@gmail.com/My Drive/GitHub Backup"

# Where the local working copies, logs and state live. Needs room for one mirror
# of every repo you own, so roughly the size of all your repos added together.
DATA_DIR="$HOME/.git-drive-backup"

# Which repos to back up. "owner" means every repo you own.
# Other choices: "owner,collaborator" or "owner,organization_member".
GH_AFFILIATION="owner"

# Stop and warn if the disk has less free space than this, in gigabytes.
MIN_FREE_GB=8

# The dashboard's port. Change it if something else already uses 3070.
DASH_PORT=3070

# Ports the restore test uses to serve a rebuilt site for you to click through.
# It takes the first free one in this range.
PREVIEW_PORT_FROM=3071
PREVIEW_PORT_TO=3080

# The name macOS uses for the scheduled jobs. Only change this before you install.
LABEL_PREFIX="com.gitdrivebackup"
